{
  "name": "daymark",
  "version": "0.2.0",
  "private": true,
  "description": "Open-source personal work and life intelligence dashboard. Track tasks, time, projects, development activity and productivity. Self-host it and own your data.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:status": "tsx scripts/db/status.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:studio": "drizzle-kit studio",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@next/env": "16.4.4",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "5.106.1",
    "better-auth": "^1.7.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "nodemailer": "10.3.1",
    "postgres": "^4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
