# ---------------------------------------------------------------------------
# Daymark environment reference
#
# Copy this file to .env.local for local development (Next.js and the db:*
# scripts read it) or to .env for Docker Compose. Never commit real values.
# Full descriptions: docs/DEPLOYMENT.md (section "Environment variables").
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Public origin of the deployment, without a trailing slash. Required in
# production. Used for auth callbacks, emails, canonical URLs and the sitemap.
# On Vercel preview deployments it may be omitted; VERCEL_URL is used instead.
APP_URL=http://localhost:3000

# single-user: registration closes automatically after the first account.
# multi-user:  independent private accounts (default).
DEPLOYMENT_MODE=multi-user

# open | invite | disabled. The very first account can always be created so a
# fresh installation can be set up. With "invite", owners create invitation
# codes from Settings -> Account.
REGISTRATION_MODE=open

# IANA timezone applied to new accounts until they choose their own.
DEFAULT_TIMEZONE=UTC

# Set to false only on self-hosted installations without an email provider.
# Password reset still requires email delivery.
REQUIRE_EMAIL_VERIFICATION=true

# debug | info | warn | error
LOG_LEVEL=info

# --- Database (PostgreSQL) ------------------------------------------------
# Runtime connection. Local Docker:   postgresql://daymark:daymark@127.0.0.1:5432/daymark
# Supabase: Connect -> "Transaction pooler" string (port 6543), e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://daymark:daymark@127.0.0.1:5432/daymark

# Direct (unpooled) connection used by migrations. Optional locally.
# Supabase: Connect -> "Direct connection" (port 5432) or "Session pooler" (5432).
DATABASE_URL_UNPOOLED=

# --- Authentication (Better Auth) -----------------------------------------
# Secret used to sign sessions and tokens. At least 32 characters.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Transactional email -------------------------------------------------
# resend | smtp | console. "console" prints emails to the server log and is
# only allowed outside production. Required in production.
EMAIL_PROVIDER=console
# Sender shown to recipients. Required for resend and smtp.
EMAIL_FROM="Daymark <no-reply@example.com>"

# EMAIL_PROVIDER=resend
RESEND_API_KEY=

# EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Docker Compose only --------------------------------------------------
# Credentials for the bundled PostgreSQL container (docker-compose.yml).
POSTGRES_USER=daymark
POSTGRES_PASSWORD=daymark
POSTGRES_DB=daymark
POSTGRES_PORT=5432
APP_PORT=3000

# --- Tests only -----------------------------------------------------------
# Separate database for `pnpm test:integration` (created by the Compose init script).
TEST_DATABASE_URL=postgresql://daymark:daymark@127.0.0.1:5432/daymark_test
